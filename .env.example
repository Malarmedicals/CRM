# Malar Medicals - CRM Environment Variables
# Copy this to .env.local and fill in your actual values

# ── Supabase (CRM's own project — separate from the e-commerce Supabase project) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-side only, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Rate limiting (Upstash Redis, used by middleware.ts) ───────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── E-commerce integration ──────────────────────────────────────────────────
# Shared secret verified in /api/integration/webhooks — must match the
# e-commerce app's WEBHOOK_SECRET exactly, since both sides HMAC-sign with it.
WEBHOOK_SECRET=
# API key checked by /api/integration/orders and /api/integration/products
# for pull-style integration calls from the e-commerce app.
INTEGRATION_API_KEY=
# Public base URL of this CRM app (used to build absolute links in outgoing
# WhatsApp/email messages).
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# ── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_API_VERSION=v18.0

# ── Email (Gmail SMTP) ──────────────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
